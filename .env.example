# ============================================================
# DÉPLOIEMENT PRODUCTION (Render - plan gratuit)
# ------------------------------------------------------------
# Ces variables doivent être définies dans les "Environment" de
# votre Web Service Render (Ne pas écrire dans ce fichier) :
#
#   APP_NAME=Gestion des auditoires
#   APP_ENV=production
#   APP_DEBUG=false
#   APP_URL=https://VOTRE-SERVICE.onrender.com
#   APP_KEY=base64:<clé générée localement, voir ci-dessous>
#   DB_CONNECTION=pgsql
#   DATABASE_URL=postgres://USER:PASSWORD@HOST:PORT/DBNAME   (PostgreSQL Render gratuit)
#   QUEUE_CONNECTION=sync                    (pas de worker sur le plan gratuit)
#   SESSION_DRIVER=database
#   CACHE_STORE=database
#   LOG_LEVEL=error
#
# Générer la clé (une seule fois, en local) :
#   php -r "echo 'base64:'.base64_encode(random_bytes(32)).PHP_EOL;"
#
# IMPORTANT — Render n'a PAS de runtime PHP natif : le Web Service
# doit être créé avec Runtime = DOCKER (le Dockerfile à la racine
# construit l'image : Apache + PHP 8.2 + Composer).
# Root Directory : laisser VIDE. Build/Start command : gérés par Docker.
#
# BASE DE DONNÉES (plan gratuit) :
#   - PAS de disque persistant (réservé aux plans payants).
#   - Utiliser la base PostgreSQL gratuite de Render :
#       New > PostgreSQL > instance type Free > Create
#     puis copier la "Internal Connection String" (même région)
#     ou l'"External Connection String" dans DATABASE_URL.
#   - La base gratuite EXPIRE après 30 jours (recréer ensuite).
# ============================================================

APP_NAME=Laravel
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost

APP_LOCALE=en
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=en_US

APP_MAINTENANCE_DRIVER=file
# APP_MAINTENANCE_STORE=database

# PHP_CLI_SERVER_WORKERS=4

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=sqlite
# DB_HOST=127.0.0.1
# DB_PORT=3306
# DB_DATABASE=laravel
# DB_USERNAME=root
# DB_PASSWORD=

SESSION_DRIVER=database
SESSION_LIFETIME=120
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=database

CACHE_STORE=database
# CACHE_PREFIX=

MEMCACHED_HOST=127.0.0.1

REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=log
MAIL_SCHEME=null
MAIL_HOST=127.0.0.1
MAIL_PORT=2525
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=
AWS_USE_PATH_STYLE_ENDPOINT=false

VITE_APP_NAME="${APP_NAME}"
